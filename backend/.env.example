# Backend Environment Variables (Railway)
# Set these in the Railway dashboard under Variables

# PostgreSQL connection string (from Railway PostgreSQL plugin)
DATABASE_URL=postgresql://user:password@container-name:5432/dbname

# URL del facial-service (usar URL interna de Railway)
FACIAL_SERVICE_URL=http://facial-service-name.railway.internal:3002

# JWT Secret (generar uno seguro para produccion)
JWT_SECRET=tu-jwt-secreto-super-seguro-aqui

# Puerto (Railway asigna automaticamente, pero se puede fijar)
PORT=3001

# CORS - dominios permitidos (separados por coma)
CORS_ORIGINS=https://tu-app.vercel.app

# Entorno
NODE_ENV=production
