# Facial Service Environment Variables (Railway)
# Set these in the Railway dashboard under Variables

# PostgreSQL connection string (misma que el backend)
DATABASE_URL=postgresql://user:password@container-name:5432/dbname

# Host (0.0.0.0 para Railway)
HOST=0.0.0.0

# Puerto (Railway asigna automaticamente)
PORT=3002

# Umbral de similitud facial (opcional)
SIMILARITY_THRESHOLD=0.45
